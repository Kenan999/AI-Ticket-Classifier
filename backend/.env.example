# Development template only; do not commit any actual API key.
LLM_PROVIDER=baseline
# GEMINI_API_KEY=obtain_from_Google_AI_Studio
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=8
# Ticket #36: only these exact nine Bitext labels are allowed.
LLM_CATEGORIES=ACCOUNT,ORDER,INVOICE,CONTACT,PAYMENT,FEEDBACK,REFUND,DELIVERY,SHIPPING
# Optional OpenAI provider; supply OPENAI_API_KEY securely at runtime, never here.
OPENAI_MODEL=gpt-4.1-mini
